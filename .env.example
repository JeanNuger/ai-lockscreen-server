# Copy this file to .env and fill in real values before running.
# .env is gitignored — never commit real secrets.

# Port the server listens on.
PORT=3000

# OpenAI API key. Create one at https://platform.openai.com/api-keys
# Leave unset during early testing — the server falls back to a local
# placeholder batch generator so /api/v1/batch still works without it.
OPENAI_API_KEY=

# Path to the SQLite database file. Created automatically on first run.
DATABASE_PATH=./data/app.db

# --- Admin panel (/admin) ---
# Username for the single admin account. Choose anything, e.g. your name.
ADMIN_USERNAME=

# Never put a plain-text password here. Generate a hash instead:
#   node scripts/hash-password.js "your-chosen-password"
# then paste the printed line below.
ADMIN_PASSWORD_HASH=

# Random secret used to sign the admin session cookie. Any long random string
# works — e.g. generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
